# Ordift Studios — environment variables
#
# Copy to .env.local for local dev (already gitignored — never commit real values).
# On Vercel, set these per-environment (Production vs. Preview/Staging) using
# Vercel's own environment scoping — staging and production must use DIFFERENT
# values for every credential/dataset below, per Plan Part J. Never reuse a
# production credential in staging.

# --- Site environment ---
# "staging" enables the basic-auth gate (proxy.ts) and noindex robots rules.
# "production" disables both. Never deploy production with this set to "staging".
SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Staging access gate (Plan Part J) ---
# Basic-auth credentials required to view the staging site at all.
# Leave unset in production (proxy.ts only enforces this when SITE_ENV=staging).
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASS=

# --- Temporary launch holding page (Milestone 0, Phase 3, see src/proxy.ts) ---
# When "true", every public route rewrites to /coming-soon instead of the
# real site. /studio, /admin, /portal, and /api stay reachable throughout,
# so staff/content work and verification can continue behind the holding
# page. Off by default (unset) — nothing changes until explicitly set to
# "true". Remove this variable entirely once the public site is ready to
# launch; it's a temporary gate, not a permanent feature.
LAUNCH_HOLDING_PAGE=

# --- Sanity CMS ---
# Staging and production MUST use separate datasets in the SAME Sanity project
# (e.g. dataset "staging" vs "production") per Plan Part J — never a shared
# dataset with flags. Project/org must be created under Ordift Studios'
# ownership (Plan Part C) before these are filled in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
SANITY_API_VERSION=2025-01-01
# Server-only. Never expose via NEXT_PUBLIC_. Used for the embedded Studio
# and any server-side writes only.
SANITY_API_TOKEN=

# --- Public contact fallback (approved 2026-07-23) ---
# Shown on /book as an alternative to the form. Editable here without a
# code change — swap for a domain email/number whenever ready. Public
# (NEXT_PUBLIC_) since these are meant to be visible to visitors.
NEXT_PUBLIC_CONTACT_EMAIL=ordift.ghana@gmail.com
# Digits only, international format, no + or spaces (wa.me link format).
NEXT_PUBLIC_WHATSAPP_NUMBER=447777371023

# --- Legal gating (Contact/Book enquiry system, approved 2026-07-23) ---
# Hard gate: real emails and real Google Sheet writes are impossible
# unless this is "true" AND SITE_ENV=production. Only set this once the
# Privacy Notice, Website Terms and Booking Terms at /legal/* hold real,
# approved text (see src/lib/enquiry/env.ts).
LEGAL_PAGES_APPROVED=false

# --- Tier 1 forms: email delivery (Resend) ---
# Server-only. Used by API routes, never sent to the browser. Ignored
# entirely unless LEGAL_PAGES_APPROVED=true and SITE_ENV=production —
# staging always logs email content instead of sending.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_ADMIN_NOTIFICATION_TO=

# --- Admin Portal operational reports (ADMIN_GUIDE.md's Operational
# Reporting section) ---
# Where "Email to Operations" in /admin/reports sends a report on
# demand. Optional: falls back to EMAIL_ADMIN_NOTIFICATION_TO above if
# unset, so this works immediately once Resend is configured — set this
# only if reports should go to a different address than transactional
# form notifications.
OPERATIONS_EMAIL=

# --- Tier 1 forms: Google Sheets (best-effort secondary copy, see
# GOOGLE_SHEETS_INTEGRATION.md) ---
# Supabase (below) is the primary, required store — these three vars
# only control the secondary Sheets copy, and a submission never fails
# because they're missing. Staging always writes to a local
# .data/staging-*.jsonl test log instead of the real spreadsheet;
# production only writes to the real spreadsheet once
# FORMS_SENDING_ENABLED=true. Run `npm run setup:google-sheets` once
# these are set to create/prepare all 9 worksheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Upstash Redis (rate limiting + idempotency, see DEPLOYMENT.md) ---
# Auto-injected by the Vercel Marketplace "Upstash for Redis" integration
# (`vercel integration add upstash-kv`) — never set these manually. One
# shared instance across Production/Preview/Development. If unset (e.g.
# local dev without `vercel env pull`), src/lib/shared/rateLimit.ts and
# src/lib/shared/idempotency.ts both fall back to an in-memory Map.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The integration also injects KV_REST_API_READ_ONLY_TOKEN, KV_URL, and
# REDIS_URL — all unused by this app (it uses the REST client, not a raw
# TCP connection) and deliberately not listed here since nothing reads
# them; they'll simply exist in Vercel's dashboard alongside the two above.

# --- Analytics (production only — Plan Part H gates this on Cookie Notice approval) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- CAPTCHA (Cloudflare Turnstile) — protects every publicly accessible
# form capable of creating a record or triggering an email:
# /portal/signup, /portal/login, Contact Enquiry (/book), and Workshop
# Registration ---
# Inert until both are set: the widget (src/components/TurnstileWidget.tsx)
# renders nothing without the site key, and server verification
# (src/lib/turnstile.ts) no-ops without the secret key. Site key is public
# by design (safe in client-side code); secret key is server-only, never
# exposed to the client or returned in any API response.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase (Client Portal auth + database, Version 1.3, approved 2026-07-24) ---
# One Supabase project, same pattern as Sanity: staging and production
# should use separate Supabase projects (not just separate tables/schemas)
# since Supabase's project-level isolation is the natural boundary for
# auth users — never let a staging test account exist in the same user
# pool as real client/model/vendor accounts. Project must be created
# under Ordift Studios' ownership.
#
# This project uses Supabase's new API key system (Publishable Key /
# Secret Key) rather than the legacy anon/service_role JWT keys — same
# privilege levels, new names and format (sb_publishable_... / sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose via NEXT_PUBLIC_. Bypasses Row Level
# Security entirely — used by src/lib/supabase/admin.ts for the
# enquiry/workshop-registration PRIMARY write (required — see
# src/lib/supabase/primaryWrite.ts and GOOGLE_SHEETS_INTEGRATION.md §1),
# the record ID sequence RPC (src/lib/shared/recordId.ts), and admin
# role management.
SUPABASE_SECRET_KEY=
