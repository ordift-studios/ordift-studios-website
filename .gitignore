# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase CLI local link state (project ref + pooler connection string,
# currently linked to production — never something to share/commit)
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling (image processing venv used for one-off brand asset scripts)
.tools-venv

# local test log for staging enquiry submissions (Plan Part G) — contains
# test PII, never committed, never mixed with production records
.data
